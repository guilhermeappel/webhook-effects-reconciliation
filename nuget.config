<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Packages come from nuget.org only. Without this a contributor's own NuGet configuration adds its sources to
       the restore: central package management then warns (NU1507), and a source that cannot be reached fails the
       vulnerability check (NU1900), which -warnaserror turns into a build error. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>